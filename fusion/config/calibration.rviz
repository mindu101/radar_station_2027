Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: ws_scan
    Background Color: 48; 48; 48
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/PointCloud2
      Name: Radar points
      Enabled: true
      Topic: /ws_points_raw
      Queue Size: 2
      Color Transformer: Intensity
      Position Transformer: XYZ
      Channel Name: intensity
      Style: Points
      Size (Pixels): 2
      Value: true
    - Class: rviz/Marker
      Name: Calibration tracks
      Enabled: true
      Topic: /learning/cluster_center
      Queue Size: 10
      Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 12
      Pitch: 0.5
      Yaw: 0.8
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
Window Geometry:
  Width: 1280
  Height: 800
